# velo5x0-bsp (VBSP-DES-5 x-failsafe-b and x-failsafe-c): full fan duty from
# early boot until velo5x0-fand takes over, and again when this unit is
# stopped at shutdown or reboot.  540 only for now (the 520 has a fan, but its
# controller is not yet identified or verified on hardware; contributions welcome).
[Unit]
Description=VeloCloud Edge 540 fan fail-safe (full duty at boot and at shutdown)
Documentation=file:/usr/share/doc/velo5x0-bsp/README.md
ConditionFirmware=smbios-field(board_name = EDGE540)
DefaultDependencies=no
Wants=systemd-modules-load.service
After=systemd-modules-load.service local-fs.target
Before=sysinit.target shutdown.target velo5x0-fand.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/modprobe -q i2c-dev
ExecStartPre=-/usr/sbin/modprobe -q vc-edge5x0-board
ExecStart=/usr/sbin/velo5x0-fan full --why early-boot
ExecStop=/usr/sbin/velo5x0-fan full --why shutdown-unit-stop

[Install]
WantedBy=sysinit.target

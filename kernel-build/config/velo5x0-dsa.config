# velo5x0-bsp kernel config fragment (VBSP-OPEN-28 option 1), applied on top
# of Debian's config.amd64_none_amd64 of the same version, then olddefconfig.
# DSA core, the Marvell 88E6xxx switch driver (88E6176) and both Marvell tag
# formats (the driver picks DSA or EDSA per chip).
CONFIG_NET_DSA=m
CONFIG_NET_DSA_MV88E6XXX=m
CONFIG_NET_DSA_TAG_DSA=m
CONFIG_NET_DSA_TAG_EDSA=m
# Debian's trusted-key bundle is not shipped in linux-source; empty it, and
# the build generates a throw-away key to sign the modules with (Debian Kernel Handbook, "Building a custom kernel from Debian source").
CONFIG_SYSTEM_TRUSTED_KEYS=""

# ---------------------------------------------------------------- constants
EMC_ADDR = 0x2F
EMC_PRODUCT_ID_REG = 0xFD
EMC_PRODUCT_ID = 0x1D
EMC_FAN_SETTING = 0x40          # duty, 0..255
EMC_PWM_DIVIDE = 0x41
EMC_FAN_CONFIG1 = 0x42
EMC_SPINUP_CFG = 0x46           # SPINUP_TIME in bits 1:0 (datasheet table 6.40)
EMC_PWM_BASE = 0x2B
EMC_LUT_CONFIG = 0x50
EMC_TACH_HI = 0x4E
EMC_TACH_LO = 0x4F
EMC_TEMP_REGS = (0x00, 0x02, 0x04, 0x06)   # internal, external 1..3 (information only)
DUTY_FULL = 0xFF
SPINUP_TIMES_S = (0.25, 0.5, 1.0, 2.0)     # SPINUP_TIME 00..11
VERIFY_MARGIN_S = 0.5
FULL_WRITE_TRIES = 3

# open-loop PWM recipe (VBSP-HW-FAN x-recipe), applied in this order
EMC_RECIPE = ((EMC_LUT_CONFIG, 0x00), (EMC_FAN_CONFIG1, 0x10),
              (EMC_PWM_BASE, 0x0C), (EMC_PWM_DIVIDE, 0x01))

PCA_RESETS_ADDR = 0x18          # never addressed by this tool
PCA_FAN_ADDR = 0x1C
PCA_IN, PCA_OUT, PCA_POL, PCA_CFG = 0, 1, 2, 3
PCA_POE_BITS = 0x03             # bits 0 and 1: PoE shutdown / reset (VBSP-REQ-7B)
PCA_FAN_BITS = 0xC0             # bit 6 FORCE_PWM (low), bit 7 FORCE_12V (high)
PCA_FAN_OUT = 0x80


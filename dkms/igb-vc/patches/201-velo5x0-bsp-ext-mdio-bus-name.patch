 static void igb_set_rx_mode(struct net_device *);
 static void igb_update_phy_info(struct timer_list *);
+static void igb_phy_info_task(struct work_struct *);
 static void igb_watchdog(struct timer_list *);
 static void igb_watchdog_task(struct work_struct *);
 static netdev_tx_t igb_xmit_frame(struct sk_buff *skb, struct net_device *);
@@ -2181,6 +2182,7 @@
 
 	del_timer_sync(&adapter->watchdog_timer);
 	del_timer_sync(&adapter->phy_info_timer);
+	cancel_work_sync(&adapter->phy_info_task);
 
 	/* record the stats before reset*/
 	spin_lock(&adapter->stats64_lock);
@@ -3402,6 +3404,7 @@
 
 	timer_setup(&adapter->watchdog_timer, igb_watchdog, 0);
 	timer_setup(&adapter->phy_info_timer, igb_update_phy_info, 0);
+	INIT_WORK(&adapter->phy_info_task, igb_phy_info_task);
 
 	INIT_WORK(&adapter->reset_task, igb_reset_task);
 	INIT_WORK(&adapter->watchdog_task, igb_watchdog_task);
@@ -3870,6 +3873,7 @@
 	set_bit(__IGB_DOWN, &adapter->state);
 	del_timer_sync(&adapter->watchdog_timer);
 	del_timer_sync(&adapter->phy_info_timer);
+	cancel_work_sync(&adapter->phy_info_task);
 
 	cancel_work_sync(&adapter->reset_task);
 	cancel_work_sync(&adapter->watchdog_task);
@@ -3892,8 +3896,9 @@
 	igb_disable_sriov(pdev, false);
 #endif
 
-	igb_vc_mii_unregister(adapter);
 	unregister_netdev(netdev);
+	/* velo5x0-bsp: after the netdev is gone, so nothing can reach the PHY */
+	igb_vc_mii_unregister(adapter);
 
 	igb_clear_interrupt_scheme(adapter);
 
@@ -5406,6 +5411,18 @@
 static void igb_update_phy_info(struct timer_list *t)
 {
 	struct igb_adapter *adapter = from_timer(adapter, t, phy_info_timer);
+
+	/* velo5x0-bsp: never touch the PHY from the timer (softirq); the PHY
+	 * of an external-MDIO port is reached under a mutex
+	 */
+	schedule_work(&adapter->phy_info_task);
+}
+
+static void igb_phy_info_task(struct work_struct *work)
+{
+	struct igb_adapter *adapter = container_of(work, struct igb_adapter,
+						   phy_info_task);
+
 	igb_get_phy_info(&adapter->hw);
 }
 

--- a/drivers/net/ethernet/intel/igb/igb.h	2026-11-24 08:01:23.249654283 +0000
+++ b/drivers/net/ethernet/intel/igb/igb.h	2026-11-24 10:23:36.556975906 +0000
@@ -565,6 +565,9 @@
 
 	struct timer_list watchdog_timer;
 	struct timer_list phy_info_timer;
+	/* velo5x0-bsp: the PHY-info refresh runs here, in process context,
+	 * because a PHY behind an external MDIO bus is accessed under a mutex */
+	struct work_struct phy_info_task;
 
 	u16 mng_vlan_id;
 	u32 bd_number;
diff -ruN -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x '.*' -x Module.symvers -x modules.order a/drivers/net/ethernet/intel/igb/igb_main.c b/drivers/net/ethernet/intel/igb/igb_main.c
